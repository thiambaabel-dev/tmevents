name: Unzip site
on:
  push:
    paths:
      - '*.zip'
      - '.github/workflows/unzip.yml'
  workflow_dispatch:
permissions:
  contents: write
  pages: write
jobs:
  unzip:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unzip
        run: |
          for z in *.zip; do unzip -o "$z"; done
          git config user.name "github-actions"
          git config user.email "github-actions@users.noreply.github.com"
          git add -A
          git commit -m "Unzip site" || echo "Rien a changer"
          git push
      - name: Rebuild Pages
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh api -X POST repos/${{ github.repository }}/pages/builds || true
